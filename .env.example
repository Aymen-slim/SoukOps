# Wassalha environment — copy to .env.local and fill in. Never commit .env.local.

# --- Primary Best-in-Class Multi-Provider AI Keys ---
# Google Gemini (primary Derja + multimodal DM brain, deep reasoning & 1024-d multimodal embeddings)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ElevenLabs Scribe v2 (primary Tunisian Derja/French voice note ASR for WA, IG, Messenger)
ELEVENLABS_API_KEY=
ELEVENLABS_ASR_MODEL=scribe_v2

# OpenAI (optional reasoning, fallback ASR, and image generation)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-6.1-sol
OPENAI_REASONING_MODEL=gpt-6-astra
OPENAI_ASR_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2.6

# Anthropic Claude (optional formal FR/EN style writing & reasoning)
ANTHROPIC_API_KEY=
ANTHROPIC_STYLE_MODEL=claude-sonnet-5-5
ANTHROPIC_REASONING_MODEL=claude-opus-5-5

# Voyage AI (optional multimodal embedding alternative)
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-multimodal-3.5

# fal.ai (optional SAM 3.1 segmentation fallback)
FAL_KEY=

# Resend (optional email push for urgent Creator/Pro alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Meta Model API & Baseten (SAM 3.1 + legacy fallbacks) ---
MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

BASETEN_API_KEY=
BASETEN_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
PE_EMBED_URL=
PE_EMBED_API_KEY=

# --- Task-Routed AI Switches ("auto" selects Gemini first when configured) ---
# FAST_LLM_PROVIDER: auto | gemini | openai | anthropic | meta | baseten
# REASONING_LLM_PROVIDER: auto | gemini | openai | anthropic | meta | baseten
# STYLE_LLM_PROVIDER: auto | gemini | openai | anthropic | meta | baseten
# ASR_PROVIDER: auto | gemini | elevenlabs | openai | transcribe | spark-open
# EMBED_PROVIDER: auto | gemini | voyage | pe
# IMAGE_PROVIDER: auto | gemini | openai | meta
# VISION_SEGMENT_MODE: auto | always | never (direct Gemini embedding first, SAM 3.1 only when needed)
FAST_LLM_PROVIDER=auto
REASONING_LLM_PROVIDER=auto
STYLE_LLM_PROVIDER=auto
LLM_PROVIDER=auto
ASR_PROVIDER=auto
EMBED_PROVIDER=auto
IMAGE_PROVIDER=auto
VISION_SEGMENT_MODE=auto
MATCHER=vector

# --- AI record/replay: live | record | replay ---
AI_MODE=live
# CASSETTE_DIR=.ai-cassettes

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
SIMULATOR_PUBLIC=true
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Google Calendar OAuth 2.0 (optional, for two-way pull/push sync) ---
# Register redirect URI: ${APP_BASE_URL}/api/calendar/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# --- Channels (WhatsApp Cloud API, Messenger, Instagram) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_CONFIG_ID=
FACEBOOK_VERIFY_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- First Delivery (E-Commerce) ---
FD_API_BASE_URL=
FD_API_TOKEN=
COURIER_CLONE_USER=agent
COURIER_CLONE_PASSWORD=wassalha
