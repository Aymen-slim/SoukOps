# Wassalha environment — copy to .env.local and fill in. Never commit .env.local.

# --- Meta Model API (https://api.meta.ai/v1) ---
MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

# --- Baseten (hosted Muse Spark Open only; key is hackathon inference key) ---
BASETEN_API_KEY=
BASETEN_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# --- Perception Encoder endpoint (Modal primary, Baseten Truss fallback) ---
# Modal: https://{workspace}--wassalha-pe-embed-predict.modal.run
PE_EMBED_URL=
# Shared secret for the PE endpoint (Modal secret "wassalha-pe"). Falls back to BASETEN_API_KEY.
PE_EMBED_API_KEY=
# Legacy alternative: BASETEN_PE_URL=https://model-{id}.api.baseten.co/environments/production/predict

# --- Provider switches ---
# LLM_PROVIDER: meta | baseten        (Spark brain / fallback)
# ASR_PROVIDER: transcribe | spark-open (set after Day 1 bake-off)
# MATCHER: vector | all                (PE+pgvector | Spark ranks whole catalog)
LLM_PROVIDER=meta
ASR_PROVIDER=transcribe
MATCHER=vector

# --- AI record/replay: live | record | replay ---
AI_MODE=live
# CASSETTE_DIR=.ai-cassettes

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallbacks also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
SIMULATOR_PUBLIC=true

# --- First Delivery (Day 6; mock by default) ---
FD_API_BASE_URL=
FD_API_TOKEN=
