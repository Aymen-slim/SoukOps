# Wassalha environment — copy to .env.local and fill in. Never commit .env.local.

# --- Meta Model API (https://api.meta.ai/v1) ---
MODEL_API_KEY=
META_SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
ASR_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

# --- Baseten (hosted Muse Spark Open only; key is hackathon inference key) ---
BASETEN_API_KEY=
BASETEN_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026

# --- Perception Encoder endpoint (Modal primary, Baseten Truss fallback) ---
# Modal: https://{workspace}--wassalha-pe-embed-predict.modal.run
PE_EMBED_URL=
# Shared secret for the PE endpoint (Modal secret "wassalha-pe"). Falls back to BASETEN_API_KEY.
PE_EMBED_API_KEY=
# Legacy alternative: BASETEN_PE_URL=https://model-{id}.api.baseten.co/environments/production/predict

# --- Provider switches ---
# LLM_PROVIDER: meta | baseten        (Spark brain / fallback)
# ASR_PROVIDER: transcribe | spark-open (set after Day 1 bake-off)
# MATCHER: vector | all                (PE+pgvector | Spark ranks whole catalog)
LLM_PROVIDER=meta
ASR_PROVIDER=transcribe
MATCHER=vector

# --- AI record/replay: live | record | replay ---
AI_MODE=live
# CASSETTE_DIR=.ai-cassettes

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallbacks also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
SIMULATOR_PUBLIC=true
# Seller map. Public browser key restricted to your domains. The page still plots Tunisia if this is empty.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Buyer place search (Google Places API (New) text search, server-only — never
# expose this key to the browser). Used to find the place a buyer describes
# when the curated landmark snapshot misses; OpenStreetMap stays the fallback.
# Enable "Places API (New)" on the key. Can be the same key as above.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=  # accepted alias when GOOGLE_PLACES_API_KEY is unset

# --- WhatsApp Cloud API (stretch; Settings > Link WhatsApp saves these to the
# merchants table via supabase/migrations/0002_whatsapp.sql — env is fallback) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# One-click link (Meta Embedded Signup): create a Meta app, add WhatsApp +
# Facebook Login for Business, create a login configuration, then set these.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_EMBEDDED_CONFIG_ID=
# Messenger + Instagram link (same Meta app; Settings buttons save page tokens
# to the merchants table via supabase/migrations/0003_social_channels.sql)
FACEBOOK_VERIFY_TOKEN=
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- First Delivery (Day 6; mock by default) ---
FD_API_BASE_URL=
FD_API_TOKEN=
# Clone portal login (local demo defaults). Headed worker: COURIER_HEADED=1 npm run worker
COURIER_CLONE_USER=agent
COURIER_CLONE_PASSWORD=wassalha
